+int shmdt(const void* shmaddr) {
+	ashv_check_pid();
+
+	pthread_mutex_lock(&mutex);
+	for (size_t i = 0; i < shmem_amount; i++) {
+		if (shmem[i].addr == shmaddr) {
+			if (munmap(shmem[i].addr, shmem[i].size) != 0) {
+				DBG("%s: munmap %p failed\n", __PRETTY_FUNCTION__, shmaddr);
+			}
+			shmem[i].addr = NULL;
