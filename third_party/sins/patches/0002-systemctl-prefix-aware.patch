+// prefixPath resolves a path under the deb-native userland prefix
+// (DN_INSTDIR); with it unset, fall back to the conventional root.
+func prefixPath(rel string) string {
+	if p := os.Getenv("DN_INSTDIR"); p != "" {
+		return filepath.Join(p, rel)
+	}
+	return "/" + rel
+}
+
+func systemMaskedDir() string {
+	if d := os.Getenv("SINS_MASKED_DIR"); d != "" {
+		return d
+	}
+	return prefixPath("etc/sins/masked")
+}
 
