post_install() {
  echo ">>> SINS (SINS Is Not Systemd) has been installed."
  echo ">>> "
  echo ">>> This package may optionally bootstrap pacman for a fresh system:"
  echo ">>> - mirrorlists (Artix + Arch repos)"
  echo ">>> - pacman repos (core/extra/multilib)"
  echo ">>> - IgnorePkg (systemd*)"
  echo ">>> - pacman-key init/populate (avoid SigLevel=Never)"
  echo ">>> "

  # Create runtime directories for compatibility
  install -d /var/log/sins-journal /etc/sins/masked
  install -d /run/systemd/system 2>/dev/null || true
  if getent group adm >/dev/null 2>&1; then
    chown root:adm /var/log/sins-journal 2>/dev/null || true
    chmod 2775 /var/log/sins-journal 2>/dev/null || chmod 755 /var/log/sins-journal
  else
    chmod 755 /var/log/sins-journal 2>/dev/null || true
  fi
  
  # Auto-enable sins-daemon only if this profile shipped the binary + runit template
  if [ -x /usr/bin/sins-daemon ] && [ -f /etc/runit/sv/sins-daemon/run ]; then
    if [ -d /run/runit/service ]; then
        SV_DIR="/run/runit/service"
    else
        SV_DIR="/var/service"
    fi
    if [ ! -L "$SV_DIR/sins-daemon" ]; then
        echo ">>> Enabling sins-daemon in $SV_DIR..."
        ln -s /etc/runit/sv/sins-daemon "$SV_DIR/sins-daemon"
        echo ">>> Starting sins-daemon..."
        # Give runit a moment to pick it up, then start
        sleep 0.5
        sv start sins-daemon 2>/dev/null || true
        echo ">>> SINS daemon enabled and started."
        echo ">>> Check status: sv status sins-daemon"
    fi
    
    echo ">>> "
    echo ">>> Desktop users: export SINS_SESSION=1 in ~/.bash_profile for user services"
    echo ">>> (pipewire, ssh-agent, etc. via systemctl --user)"
  fi

  # ---- pacman bootstrap (best-effort) ----
  pacman_bootstrap || true

  # ---- lib64 compatibility (best-effort) ----
  ensure_lib64_compat || true
}

post_upgrade() {
  post_install
}

post_remove() {
  # Clean up sins-daemon symlink
  if [ -d /run/runit/service ]; then
      SV_DIR="/run/runit/service"
  else
      SV_DIR="/var/service"
  fi
  
  if [ -L "$SV_DIR/sins-daemon" ]; then
      echo ">>> Disabling sins-daemon..."
      rm "$SV_DIR/sins-daemon"
  fi
}

_sins_backup_once() {
  # $1: path to backup
  local src="${1:?}"
  [ -f "$src" ] || return 0
  [ -f "${src}.sins.bak" ] && return 0
  cp -a "$src" "${src}.sins.bak" 2>/dev/null || true
}

_sins_ensure_line_in_file() {
  # $1: file, $2: exact line
  local f="${1:?}" line="${2:?}"
  [ -f "$f" ] || return 1
  grep -Fxq "$line" "$f" && return 0
  printf '%s\n' "$line" >> "$f"
}

_sins_write_file_if_missing() {
  # $1: file, stdin: contents
  local f="${1:?}"
  if [ -f "$f" ]; then
    return 0
  fi
  install -d "$(dirname "$f")"
  cat >"$f"
}

pacman_bootstrap() {
  # Do not hard-fail installs: this is for new/empty systems.
  command -v pacman >/dev/null 2>&1 || return 0

  local pacman_conf="/etc/pacman.conf"
  [ -f "$pacman_conf" ] || return 0

  echo ">>> Bootstrapping pacman (SINS)..."

  _sins_backup_once "$pacman_conf"

  # 1) Mirrorlists (create only if missing)
  _sins_write_file_if_missing "/etc/pacman.d/mirrorlist-artix" <<'EOF'
## SINS bootstrap mirrorlist (Artix)
## You may replace these with closer mirrors later.
Server = https://mirror1.artixlinux.org/repos/$repo/os/$arch
Server = https://mirror.pascalpuffke.de/artix-linux/repos/$repo/os/$arch
EOF

  _sins_write_file_if_missing "/etc/pacman.d/mirrorlist-arch" <<'EOF'
## SINS bootstrap mirrorlist (Arch repos via pacman)
## You may replace these with closer mirrors later.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
EOF

  # 2) Ensure pacman knows about the two mirrorlists (do not duplicate)
  # Artix installs usually already have /etc/pacman.d/mirrorlist; keep it.
  if ! grep -Eq '^\s*Include\s*=\s*/etc/pacman\.d/mirrorlist-artix\s*$' "$pacman_conf"; then
    # Prefer under [options] if it exists; else append near the top.
    if grep -Eq '^\[options\]' "$pacman_conf"; then
      # Insert right after [options] line
      _sins_backup_once "$pacman_conf"
      awk '
        BEGIN{done=0}
        /^\[options\]$/{
          print;
          if(!done){print "Include = /etc/pacman.d/mirrorlist-artix"; done=1}
          next
        }
        {print}
      ' "$pacman_conf" > "${pacman_conf}.sins.tmp" && mv "${pacman_conf}.sins.tmp" "$pacman_conf"
    else
      _sins_ensure_line_in_file "$pacman_conf" "Include = /etc/pacman.d/mirrorlist-artix"
    fi
  fi

  # 2b) Artix repos: ensure they use the Artix mirrorlist include.
  # On Artix the default is usually Include = /etc/pacman.d/mirrorlist
  # under [system]/[world]/[galaxy]. We keep existing custom includes.
  if grep -Eq '^\[(system|world|galaxy)\]\s*$' "$pacman_conf"; then
    for _r in system world galaxy; do
      if grep -Eq "^\\[${_r}\\]\\s*$" "$pacman_conf"; then
        # If the section includes the generic mirrorlist, swap it to mirrorlist-artix.
        # Only touches the Include line inside that section.
        awk -v repo="$_r" '
          BEGIN{in=0}
          $0 ~ ("^\\[" repo "\\]$") {in=1; print; next}
          in==1 && $0 ~ /^\\[/ {in=0; print; next}
          in==1 && $0 ~ /^\\s*Include\\s*=\\s*\\/etc\\/pacman\\.d\\/mirrorlist\\s*$/ {
            print "Include = /etc/pacman.d/mirrorlist-artix"; next
          }
          {print}
        ' "$pacman_conf" > "${pacman_conf}.sins.tmp" && mv "${pacman_conf}.sins.tmp" "$pacman_conf"
      fi
    done
  fi

  # 3) Add Arch repos (core/extra/multilib) if missing
  if ! grep -Eq '^\[core\]\s*$' "$pacman_conf"; then
    cat >>"$pacman_conf" <<'EOF'

### ---- SINS: Arch repos (pacman) ----
[core]
Include = /etc/pacman.d/mirrorlist-arch

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
### ---- /SINS ----
EOF
  fi

  # 4) IgnorePkg: protect shim from being overwritten by real systemd
  if grep -Eq '^\s*IgnorePkg\s*=' "$pacman_conf"; then
    # Append if not present
    if ! grep -Eq '^\s*IgnorePkg\s*=.*\bsystemd\b' "$pacman_conf"; then
      sed -i -E 's|^(\s*IgnorePkg\s*=.*)$|\1 systemd systemd-libs systemd-sysvcompat|g' "$pacman_conf" 2>/dev/null || true
    fi
  else
    # Put under [options] if possible, else append.
    if grep -Eq '^\[options\]' "$pacman_conf"; then
      awk '
        BEGIN{done=0}
        /^\[options\]$/{
          print;
          next
        }
        done==0 && $0 ~ /^(\s*Include\s*=)/{
          print;
          print "IgnorePkg = systemd systemd-libs systemd-sysvcompat";
          done=1;
          next
        }
        {print}
        END{ if(done==0){ print ""; print "IgnorePkg = systemd systemd-libs systemd-sysvcompat" } }
      ' "$pacman_conf" > "${pacman_conf}.sins.tmp" && mv "${pacman_conf}.sins.tmp" "$pacman_conf"
    else
      _sins_ensure_line_in_file "$pacman_conf" "IgnorePkg = systemd systemd-libs systemd-sysvcompat"
    fi
  fi

  # 5) PGP keys: init + populate keyrings (best-effort, no SigLevel=Never needed)
  if command -v pacman-key >/dev/null 2>&1; then
    echo ">>> Initializing pacman keyring (best-effort)..."
    pacman-key --init >/dev/null 2>&1 || true
    # Populate both keyrings if available. Not all systems have both.
    pacman-key --populate artix >/dev/null 2>&1 || true
    pacman-key --populate archlinux >/dev/null 2>&1 || true
    # Install/refresh keyring packages if repos are reachable.
    pacman -Sy --noconfirm --needed artix-keyring archlinux-keyring >/dev/null 2>&1 || true
    # Refresh keys can take a while / require network; don't block install.
    if command -v timeout >/dev/null 2>&1; then
      timeout 120 pacman-key --refresh-keys >/dev/null 2>&1 || true
    else
      pacman-key --refresh-keys >/dev/null 2>&1 || true
    fi
  fi

  echo ">>> pacman bootstrap done."
}

ensure_lib64_compat() {
  # If /usr/lib64 is a real dir (not a symlink), some binaries will look there.
  # If it's a symlink to /usr/lib (common), we must NOT create/own it as a package file.
  [ -e /usr/lib/libsystemd.so.0 ] || return 0

  if [ -d /usr/lib64 ] && [ ! -L /usr/lib64 ]; then
    echo ">>> Ensuring /usr/lib64 libsystemd compatibility symlinks..."
    ln -sf ../lib/libsystemd.so.0 /usr/lib64/libsystemd.so.0 2>/dev/null || true
    ln -sf libsystemd.so.0 /usr/lib64/libsystemd.so 2>/dev/null || true

    if [ -f /usr/lib/pkgconfig/libsystemd.pc ]; then
      install -d /usr/lib64/pkgconfig 2>/dev/null || true
      sed 's|^libdir=.*$|libdir=${prefix}/lib64|' /usr/lib/pkgconfig/libsystemd.pc > /usr/lib64/pkgconfig/libsystemd.pc 2>/dev/null || true
    fi
  fi
}
