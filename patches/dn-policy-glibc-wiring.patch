 #include <errno.h>
+#include <fcntl.h>
 #include <sys/stat.h>
 #include <sysdep.h>
+#include <dn-prefix.h>
 #include <fakesyscall.h>
 
 int
 statx (int fd, const char *path, int flags,
        unsigned int mask, struct statx *buf)
 {
+#if !IS_IN (rtld)
+  /* dn-policy path rewriting: absolute guest paths only; a relative
+     @path is left for the kernel's dirfd.  No owner rewrite here --
+     statx never succeeds on Android (the fakesyscall bucket returns
+     ENOSYS), callers fall back to fstatat().  */
+  char dn_path[DN_PREFIX_MAX];
+
+  if (path != NULL && path[0] == '/')
+    path = (flags & AT_SYMLINK_NOFOLLOW)
+      ? dn_policy_redirect_nofollow (dn_path, sizeof dn_path, path)
+      : dn_policy_redirect (dn_path, sizeof dn_path, path);
+#endif
   return syscall (__NR_statx, fd, path, flags, mask, buf);
 }
