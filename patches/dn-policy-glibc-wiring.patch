@@ -21,11 +21,26 @@
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sysdep.h>
+#include <dn-prefix.h>
 
 
 int
 __faccessat (int fd, const char *file, int mode, int flag)
 {
+#if !IS_IN (rtld)
+  /* dn-policy path rewriting: absolute guest paths only; a relative
+     @file is left for the kernel (its dirfd is already a real path).
+     The stat-based fallback below passes the translated host path
+     through __fstatat64_time64() idempotently, so translating once
+     here covers both branches.  */
+  char dn_path[DN_PREFIX_MAX];
+
+  if (file != NULL && file[0] == '/')
+    file = (flag & AT_SYMLINK_NOFOLLOW)
+      ? dn_policy_redirect_nofollow (dn_path, sizeof dn_path, file)
+      : dn_policy_redirect (dn_path, sizeof dn_path, file);
+#endif
+
   if ((flag == 0 || ((flag & ~AT_EACCESS) == 0 && ! __libc_enable_secure)))
     return INLINE_SYSCALL (faccessat, 3, fd, file, mode);
 
