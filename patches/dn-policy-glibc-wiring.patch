diff -ruN '--exclude=.pc' '--exclude=debian' work-after-official-patch/elf/Makefile work/elf/Makefile
--- work-after-official-patch/elf/Makefile	2026-10-08 07:51:05.224680319 +0000
+++ work/elf/Makefile	2026-10-08 08:44:33.486284751 +0000
@@ -1465,6 +1465,12 @@
 # their implementation is provided differently in rtld, and the symbol
 # discovery mechanism is not compatible with the libc implementation
 # when compiled for libc.
+#
+# dn_policy_fake_stat: deb-native.  Same reason as the malloc family
+# above -- dn-policy-glue.c's stat post-processing reaches
+# dn-policy-fakeroot.o, which uses malloc/flock.  Stubbing it keeps the
+# owner-store object out of the loader's link map (it must not go into
+# ld.so); libc-proper still links the real one.
 rtld-stubbed-symbols = \
   __libc_assert_fail \
   __syscall_cancel \
@@ -1472,6 +1478,7 @@
   free \
   malloc \
   realloc \
+  dn_policy_fake_stat \
   # rtld-stubbed-symbols
 
 ifeq ($(have-ssp),yes)
diff -ruN '--exclude=.pc' '--exclude=debian' work-after-official-patch/sysdeps/generic/dn-prefix.h work/sysdeps/generic/dn-prefix.h
--- work-after-official-patch/sysdeps/generic/dn-prefix.h	2026-10-08 07:51:03.964680319 +0000
+++ work/sysdeps/generic/dn-prefix.h	2026-10-08 08:49:59.098284627 +0000
@@ -149,4 +149,34 @@
   return path;
 }
 
+/* dn-policy wiring (sysdeps/unix/sysv/linux/dn-policy-glue.c): the
+   real policy (symlink resolution, no-double-translation, the
+   /proc,/sys,/dev passthrough), not just __dn_redirect's plain root
+   list above. Not available to rtld itself (IS_IN (rtld)) -- dn-policy
+   uses malloc/flock, which the minimal rtld build can't link (see this
+   file's own top comment on why __dn_redirect stays rtld-safe-only);
+   rtld's own bootstrap paths (ld.so.preload, the cache) keep using
+   __dn_redirect. Only libc-proper calls into dn-policy for real, and
+   only from the calls that need it: the open()/openat() and the
+   stat()/fstatat()/statx()/faccessat() families so far (runtime.md's
+   "path group"), called long after the dynamic linker has finished. */
+#if !IS_IN (rtld)
+extern const char *dn_policy_redirect (char *buf, size_t bufsz, const char *path);
+/* Same, but never resolving the final component -- O_NOFOLLOW /
+   AT_SYMLINK_NOFOLLOW (dn_policy_translate_path_nofollow()). */
+extern const char *dn_policy_redirect_nofollow (char *buf, size_t bufsz, const char *path);
+/* Rewrite a stat-family result's owner fields from the owner store
+   before it is handed back to the guest (docs/spec/runtime.md, "Fake
+   root").  @st is really a `struct stat`; spelled void* so this header
+   need not pull <sys/stat.h> into every includer. */
+extern void dn_policy_stat_post (const char *host_path, void *st);
+/* Reverse translation (runtime.md, "Reverse translation"): turn a real
+   host path the kernel returned into the guest path.  getcwd() rewrites
+   @buf (NUL-terminated, capacity @cap) in place; readlink()'s result is
+   @n bytes in @buf (capacity @len, NOT NUL-terminated) and is rewritten
+   only if it still fits.  Both leave a value outside TREE/RT alone. */
+extern void dn_policy_getcwd_post (char *buf, size_t cap);
+extern long dn_policy_readlink_post (char *buf, size_t len, long n);
+#endif
+
 #endif /* _DN_PREFIX_H */
