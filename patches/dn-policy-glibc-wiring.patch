@@ -105,7 +106,29 @@
 __fstatat64_time64 (int fd, const char *file, struct __stat64_t64 *buf,
 		    int flag)
 {
-  int r = fstatat64_time64_stat (fd, file, buf, flag);
+  int r;
+
